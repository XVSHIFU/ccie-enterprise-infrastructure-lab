config
system
 host-name               vBond-Real
 system-ip               10.2.255.221
 site-id                 2
 admin-tech-on-failure
 no route-consistency-check
 organization-name       CCIE-EI-LAB
 vbond 10.2.251.2 local
 aaa
  auth-order local radius tacacs
  usergroup basic
   task system read write
   task interface read write
  exit
  usergroup netadmin
  exit
  usergroup operator
   task system read
   task interface read
   task policy read
   task routing read
   task security read
  exit
  usergroup tenantadmin
  exit
  user admin
   password <对应实验密钥>
  exit
 exit
 logging
  disk
   enable
  exit
 exit
exit
omp
 no shutdown
 graceful-restart
 advertise connected
 advertise static
exit
security
 ipsec
  authentication-type ah-sha1-hmac sha1-hmac
 exit
exit
vpn 0
 interface ge0/0
  ip address 10.2.251.2/24
  ipv6 dhcp-client
  tunnel-interface
   encapsulation ipsec
   allow-service all
   no allow-service bgp
   allow-service dhcp
   allow-service dns
   allow-service icmp
   no allow-service sshd
   no allow-service netconf
   no allow-service ntp
   no allow-service ospf
   no allow-service stun
   allow-service https
  exit
  no shutdown
 exit
 ip route 0.0.0.0/0 10.2.251.1
exit
vpn 512
 interface eth0
  ip dhcp-client
  no shutdown
 exit
exit
commit and-quit
