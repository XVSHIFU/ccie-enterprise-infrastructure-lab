enable
configure terminal
service compress-config
hostname sw212
no aaa new-model
clock timezone EET 2 0
no ip domain-lookup
spanning-tree mode pvst
spanning-tree extend system-id
no cdp run
interface Loopback0
 no shutdown
 ip address 10.2.255.212 255.255.255.255
 ip ospf 1 area 0
exit
interface Ethernet0/0
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.21.2 255.255.255.252
 ip ospf 1 area 0
exit
interface Ethernet0/1
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.23.2 255.255.255.252
 ip ospf 1 area 0
exit
interface Ethernet0/2
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.119.2 255.255.255.252
 ip ospf 1 area 0
exit
interface Ethernet0/3
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.215.2 255.255.255.252
 ip ospf 1 area 0
exit
interface Ethernet1/0
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.214.2 255.255.255.252
 ip ospf 1 area 0
exit
interface Ethernet1/1
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.254.1 255.255.255.0
 ip ospf 1 area 0
exit
interface Ethernet1/2
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.253.1 255.255.255.0
 ip ospf 1 area 0
exit
router ospf 1
 prefix-suppression
 passive-interface Ethernet1/1
 passive-interface Ethernet1/2
exit
no ip http server
no ip http secure-server
ip ssh server algorithm encryption aes128-ctr aes192-ctr aes256-ctr
ip ssh client algorithm encryption aes128-ctr aes192-ctr aes256-ctr
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
exit
line vty 0 4
 privilege level 15
 no login
 transport input all
exit
end
write memory
