enable
configure terminal
hostname host12
no aaa new-model
clock timezone EET 2 0
ipv6 unicast-routing
no cdp run
interface Ethernet0/0
 no shutdown
 description https://ccielabcenter.com
 ip address dhcp
 ipv6 address autoconfig default
exit
interface Ethernet0/1
 no shutdown
 description https://ccielabcenter.com
 no ip address
exit
interface Ethernet0/2
 no shutdown
 description https://ccielabcenter.com
 no ip address
exit
interface Ethernet0/3
 no shutdown
 description https://ccielabcenter.com
 no ip address
exit
no ip http server
no ip http secure-server
line con 0
 logging synchronous
exit
line vty 0 4
 login
 transport input none
exit
end
write memory
