enable
configure terminal
service compress-config
hostname sw201
no aaa new-model
clock timezone EET 2 0
no ip domain-lookup
key chain ccie
 key 1
  key-string <对应实验密钥>
  cryptographic-algorithm hmac-sha-384
 exit
exit
spanning-tree mode pvst
spanning-tree extend system-id
vlan 3999
 name "SDA Underlay"
exit
vlan 4000
 name "SD-WAN Underlay"
exit
no cdp run
interface Loopback0
 no shutdown
 ip address 10.2.255.201 255.255.255.255
 ip ospf 1 area 0
exit
interface Ethernet0/0
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.10.2 255.255.255.252
 ip ospf 1 area 0
 duplex full
exit
interface Ethernet0/1
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.12.2 255.255.255.252
 ip ospf 1 area 0
 duplex full
exit
interface Ethernet0/2
 no shutdown
 description https://ccielabcenter.com
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 4000
 switchport mode trunk
exit
interface Ethernet0/3
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.109.1 255.255.255.252
 ip ospf 1 area 0
 duplex full
exit
interface Ethernet1/0
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.23.1 255.255.255.252
 ip ospf 1 area 0
 duplex full
exit
interface Ethernet1/1
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.20.1 255.255.255.252
 ip ospf 1 area 0
 duplex full
exit
interface Ethernet1/2
 no shutdown
 description https://ccielabcenter.com
 no switchport
 ip address 10.2.241.1 255.255.255.252
 ip ospf authentication key-chain ccie
 ip ospf bfd
 ip ospf 1 area 0
 duplex full
 bfd interval 100 min_rx 100 multiplier 3
exit
interface Ethernet1/3
 no shutdown
 switchport trunk encapsulation dot1q
 switchport trunk native vlan 4000
 switchport mode trunk
exit
interface Vlan3999
 no shutdown
 ip address 10.2.201.11 255.255.255.248
 ip ospf 1 area 0
exit
interface Vlan4000
 no shutdown
 ip address 10.2.201.3 255.255.255.248
 ip ospf prefix-suppression disable
 ip ospf 1 area 0
exit
router ospf 1
exit
ip http server
ip http secure-server
ip ssh server algorithm encryption aes128-ctr aes192-ctr aes256-ctr
ip ssh client algorithm encryption aes128-ctr aes192-ctr aes256-ctr
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
exit
line vty 0 4
 privilege level 15
 no login
 transport input all
exit
end
write memory
