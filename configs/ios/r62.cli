enable
configure terminal
hostname r62
vrf definition WAN
 rd 65006:62
 address-family ipv4
  exit-address-family
exit
no aaa new-model
no ip domain lookup
crypto keyring KR vrf WAN
 pre-shared-key address 0.0.0.0 0.0.0.0 key cisco
exit
crypto isakmp policy 10
 encr 3des
 authentication pre-share
 group 2
exit
crypto ipsec transform-set trans esp-3des esp-md5-hmac
 mode tunnel
exit
crypto ipsec profile prof
 set security-association lifetime seconds 900
 set transform-set trans
exit
interface Loopback0
 no shutdown
 vrf forwarding WAN
 ip address 10.6.255.62 255.255.255.255
exit
interface Tunnel0
 no shutdown
 ip address 10.200.0.62 255.255.255.0
 no ip redirects
 ip mtu 1440
 ip nhrp map 10.200.0.1 10.2.255.24
 ip nhrp map multicast 10.2.255.24
 ip nhrp network-id 1010
 ip nhrp nhs 10.200.0.1
 tunnel source Loopback0
 tunnel mode gre multipoint
 tunnel vrf WAN
 tunnel protection ipsec profile prof
exit
interface Ethernet0/0
 no shutdown
 vrf forwarding WAN
 ip address 100.6.62.2 255.255.255.252
exit
interface Ethernet0/1
 no shutdown
 ip address 10.6.99.2 255.255.255.252
exit
interface Ethernet0/2
 no shutdown
 ip address 10.6.13.1 255.255.255.252
exit
interface Ethernet0/3
 no shutdown
 ip address 10.6.11.1 255.255.255.252
exit
router eigrp ccie
 address-family ipv4 unicast autonomous-system 65006
  af-interface default
   passive-interface
   exit-af-interface
  af-interface Tunnel0
   no passive-interface
   exit-af-interface
  af-interface Ethernet0/1
   no passive-interface
   exit-af-interface
  af-interface Ethernet0/2
   no passive-interface
   exit-af-interface
  af-interface Ethernet0/3
   no passive-interface
   exit-af-interface
  topology base
   exit-af-topology
  network 10.6.0.0 0.0.255.255
  network 10.200.0.0 0.0.0.255
  exit-address-family
exit
router bgp 65006
 bgp log-neighbor-changes
 address-family ipv4 vrf WAN
  network 10.6.255.62 mask 255.255.255.255
  neighbor 100.6.62.1 remote-as 10000
  neighbor 100.6.62.1 activate
  exit-address-family
exit
no ip http server
no ip http secure-server
line con 0
 exec-timeout 0 0
 logging synchronous
exit
line vty 0 4
 login
 transport input none
exit
end
write memory
